-- 9. Bicicletas disponibles por ciudad
CREATE OR ALTER FUNCTION fn_BicicletasDisponiblesPorCiudad(@nombreCiudad VARCHAR(100))
RETURNS TABLE
AS
RETURN
(
    SELECT 
        b.id_bicicleta, 
        b.modelo, 
        m.nombre AS marca, 
        pa.nombre AS punto_alquiler
    FROM bicicletas b
    JOIN marcas m ON b.id_marca = m.id_marca
    JOIN puntos_de_alquiler pa ON pa.id_punto_alquiler = b.id_punto_de_alquiler
    JOIN ciudades c ON pa.id_ciudad = c.id_ciudad
    WHERE c.nombre = @nombreCiudad AND b.activo = 1
);
GO

-- 10. Historial de mantenimientos de una bicicleta
CREATE OR ALTER FUNCTION fn_HistorialMantenimientosBicicleta(@id_bicicleta INT)
RETURNS TABLE
AS
RETURN
(
    SELECT 
        m.descripcion, 
        tm.nombre AS tipo_mantenimiento, 
        m.fecha_de_inicio, 
        m.fecha_de_fin
    FROM mantenimientos m
    JOIN tipos_de_mantenimiento tm 
        ON m.id_tipo_de_mantenimiento = tm.id_tipo_de_mantenimiento
    WHERE m.id_bicicleta = @id_bicicleta
    ORDER BY m.fecha_de_inicio DESC
);
GO

-- 11. Alquileres activos por usuario
CREATE OR ALTER FUNCTION fn_AlquileresActivosPorUsuario(@id_usuario INT)
RETURNS TABLE
AS
RETURN
(
    SELECT 
        a.id_alquiler, 
        b.modelo, 
        a.fecha_de_inicio_de_vigencia, 
        a.fecha_de_fin_de_vigencia, 
        a.tarifa_total
    FROM alquileres a
    JOIN bicicletas b ON a.id_bicicleta = b.id_bicicleta
    WHERE a.id_usuario = @id_usuario
      AND GETDATE() BETWEEN a.fecha_de_inicio_de_vigencia AND a.fecha_de_fin_de_vigencia
);
GO

-- ======================================
-- SECCIÓN 3: CONSULTAS DE AGREGACIÓN
-- ======================================

-- 12. Promedio de duración de los alquileres (en días)
SELECT 
    AVG(DATEDIFF(DAY, fecha_de_inicio_de_vigencia, fecha_de_fin_de_vigencia)) AS PromedioDiasAlquiler
FROM alquileres;
GO

-- 13. Total de bicicletas activas por ciudad
SELECT 
    c.nombre AS Ciudad, 
    COUNT(*) AS TotalBicicletas
FROM bicicletas b
JOIN puntos_de_alquiler p ON b.id_punto_de_alquiler = p.id_punto_alquiler
JOIN ciudades c ON p.id_ciudad = c.id_ciudad
WHERE b.activo = 1
GROUP BY c.nombre;
GO

-- 14. Promedio de tarifa por tipo de plan
SELECT 
    tipo_de_plan, 
    AVG(tarifa_asociada) AS PromedioTarifa
FROM planes_de_los_alquileres
GROUP BY tipo_de_plan;
GO

-- 15. Total recaudado por ciudad
SELECT 
    c.nombre AS Ciudad, 
    SUM(a.tarifa_total) AS TotalRecaudado
FROM alquileres a
JOIN bicicletas b ON a.id_bicicleta = b.id_bicicleta
JOIN puntos_de_alquiler p ON b.id_punto_de_alquiler = p.id_punto_alquiler
JOIN ciudades c ON p.id_ciudad = c.id_ciudad
GROUP BY c.nombre;
GO
